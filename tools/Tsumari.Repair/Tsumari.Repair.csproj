<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>
  <!-- Compile only reusable provider helpers. Never build/start the bot project. -->
  <ItemGroup>
    <Compile Include="../../src/Tsumari.Bot/TranslationProviders/OllamaTranslationProvider.cs" Link="Bot/OllamaTranslationProvider.cs" />
    <Compile Include="../../src/Tsumari.Bot/TranslationProviders/Abstractions/*.cs" Link="Bot/%(Filename)%(Extension)" />
    <Compile Include="../../src/Tsumari.Bot/Models/LanguageAnalysisResult.cs" Link="Bot/LanguageAnalysisResult.cs" />
    <Compile Include="../../src/Tsumari.Bot/Models/TranslationProviderConfigurationReport.cs" Link="Bot/TranslationProviderConfigurationReport.cs" />
    <Compile Include="../../src/Tsumari.Bot/Services/LanguageCodeService.cs" Link="Bot/LanguageCodeService.cs" />
    <Compile Include="../../src/Tsumari.Bot/Services/MirroredMessageNoticeLocalizer.cs" Link="Bot/MirroredMessageNoticeLocalizer.cs" />
    <Compile Include="../../src/Tsumari.Bot/Extensions/HttpResponseExtensions.cs" Link="Bot/HttpResponseExtensions.cs" />
    <Compile Include="../../src/Tsumari.Bot/Logging/HttpResponseLog.cs" Link="Bot/HttpResponseLog.cs" />
    <Compile Include="../../src/Tsumari.Bot/Constants/HttpClientNames.cs" Link="Bot/HttpClientNames.cs" />
  </ItemGroup>
</Project>
